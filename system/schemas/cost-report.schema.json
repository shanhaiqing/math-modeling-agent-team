{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/modeling/cost-report.schema.json",
  "title": "Run Cost Report",
  "description": "Token, wall-time, and human-time accounting per stage and role. Token values are null when the meter is unavailable; wall/human times remain valid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "route_version", "profile", "stages", "total", "baseline", "notes"],
  "properties": {
    "run_id": {"type": "string"},
    "route_version": {"type": "string"},
    "profile": {"enum": ["quality", "balanced", "economy"]},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "role", "model", "effort", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "estimated_cost", "wall_minutes", "human_minutes", "rework_count"],
        "properties": {
          "stage": {"type": "string"},
          "role": {"type": "string"},
          "model": {"type": "string"},
          "effort": {"type": "string"},
          "input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
          "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
          "estimated_cost": {"type": ["number", "null"], "minimum": 0},
          "wall_minutes": {"type": "number", "minimum": 0},
          "human_minutes": {"type": "number", "minimum": 0},
          "rework_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "estimated_cost", "wall_minutes", "human_minutes", "rework_count"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost": {"type": ["number", "null"], "minimum": 0},
        "wall_minutes": {"type": "number", "minimum": 0},
        "human_minutes": {"type": "number", "minimum": 0},
        "rework_count": {"type": "integer", "minimum": 0}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": {"type": ["string", "null"]},
        "input_tokens": {"type": ["integer", "null"]},
        "output_tokens": {"type": ["integer", "null"]},
        "wall_minutes": {"type": ["number", "null"]},
        "human_minutes": {"type": ["number", "null"]},
        "delta_pct": {"type": ["number", "null"]}
      }
    },
    "pricing": {"type": "object", "additionalProperties": true},
    "notes": {"type": "string"}
  }
}
