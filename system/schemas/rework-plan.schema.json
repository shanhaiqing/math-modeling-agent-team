{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/modeling/rework-plan.schema.json",
  "title": "Rework Plan",
  "description": "Written by a fresh solver BEFORE coding. Maps every failure mode to a countermeasure, verification, and regression test; the plan is gated before code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "dossier_ids",
    "approach",
    "changes",
    "unchanged_parts",
    "similarity_to_rejected",
    "regression_checks",
    "risks",
    "budget"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "dossier_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "approach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "algorithm", "model_structure", "why_it_avoids_failure"],
      "properties": {
        "method": {"type": "string"},
        "algorithm": {"type": "string"},
        "model_structure": {"type": "string"},
        "why_it_avoids_failure": {"type": "string"}
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure_mode_id", "countermeasure", "verification", "residual_risk"],
        "properties": {
          "failure_mode_id": {"type": "string"},
          "countermeasure": {"type": "string"},
          "verification": {"type": "string"},
          "residual_risk": {"type": "string"}
        }
      }
    },
    "unchanged_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part", "why_safe"],
        "properties": {
          "part": {"type": "string"},
          "why_safe": {"type": "string"}
        }
      }
    },
    "similarity_to_rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materially_same", "justification", "new_evidence"],
      "properties": {
        "materially_same": {"type": "boolean"},
        "justification": {"type": "string"},
        "new_evidence": {"type": "string"}
      }
    },
    "regression_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure_mode_id", "command", "expected", "evidence"],
        "properties": {
          "failure_mode_id": {"type": "string"},
          "command": {"type": "string"},
          "expected": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_minutes", "token_estimate"],
      "properties": {
        "wall_minutes": {"type": "number", "minimum": 0},
        "token_estimate": {"type": "number", "minimum": 0}
      }
    }
  }
}
