        "compliance"
      ],
      "reports": [],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": {
        "mode": "fallback"
      },
      "report_shape": "summary_error",
      "run_after": [
        "compliance_manifest"
      ],
      "description": "fallback-mode evidence-chain audit"
    }
  ],
  "asset_maintenance": [
    {
      "id": "asset_viz_tests",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_viz_tests.py",
        "{repo}/tools/checks"
      ],
      "when": "asset_changed",
      "blocking": "WARN",
      "description": "visualization style regression tests"
    }
  ],
  "retired": [
    {
      "id": "check_reflection",
      "path": "tools/checks/check_reflection.py",
      "disposition": "retire",
      "reason": "S1-S4 reflection logs are no longer live pipeline artifacts"
    },
    {
      "id": "check_isolation",
      "path": "tools/checks/check_isolation.py",
      "disposition": "move_to_evolution",
      "reason": "calibration/extraction isolation audit belongs to the evolution toolkit"
    },
    {
      "id": "test_family",
      "path": "tools/checks/test_*.py",
      "disposition": "move_to_tests",
      "reason": "unit/regression tests belong under tests/, not the pipeline manifest"
    }
  ],
  "report_shapes": {
    "finding": "findings[] with level/rule/location/message; normalize to error_count/warn_count",
    "error_count": "top-level error_count and warn_count",
    "summary_error": "summary.ERROR and summary.WARN",
    "exit_code": "non-zero exit is ERROR; no report file"
  },
  "notes": [
    "check_machine_checks is fallback-only; kernel mode records evidence directly",
    "the manifest check must run after all business checks and before check_machine_checks",
    "WARN does not block; the downstream reviewer/human adjudicates",
    "no check may require more than the corresponding prompt/skill requires",
    "modeling_rework_plan is a kernel gate: it validates decision_logs/rework_plan.json against failure_dossier.json before the fresh solver writes code",
    "regression_check_report is produced by running the rework plan's acceptance tests; a failing test blocks MODELING"
  ]
}
