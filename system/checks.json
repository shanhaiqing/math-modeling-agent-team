{
  "checks_version": "3.0.0",
  "schema_version": "2026-10-19",
  "description": "Stage->check manifest for the modeling pipeline kernel. Commands use placeholders resolved by the kernel: {python}, {repo}, {root}, {profile}, {track}, {year}, {round}.",
  "python": {
    "preferred": "{repo}/.venv/Scripts/python.exe",
    "fallback": "python"
  },
  "placeholders": [
    "python",
    "repo",
    "root",
    "profile",
    "track",
    "year",
    "round"
  ],
  "execution_order": {
    "rule": "business checks -> check_pipeline_manifest -> check_machine_checks; kernel enforces, model cannot reorder",
    "manifest_check_id": "manifest",
    "machine_checks_suffix": "_machine_checks"
  },
  "checks": [
    {
      "id": "intake_convert",
      "stage": "INTAKE",
      "order": 10,
      "kind": "convert",
      "command": [
        "{python}",
        "{repo}/tools/checks/convert_problem.py",
        "--project-root",
        "{root}"
      ],
      "reports": [
        "赛题/ingest_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 300,
      "when": null,
      "report_shape": "error_count",
      "run_after": [],
      "description": "convert problem PDF/attachments into 赛题/题面.md; no agent-side PDF extraction"
    },
    {
      "id": "intake_problem_track",
      "stage": "INTAKE",
      "order": 20,
      "kind": "contract",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_problem_track.py",
        "--state",
        "{root}/pipeline_state.json"
      ],
      "reports": [],
      "blocking": "ERROR",
      "timeout_seconds": 30,
      "when": null,
      "phase": "gate_pre",
      "gate": "G0",
      "report_shape": "exit_code",
      "run_after": [],
      "description": "problem_track must be opt/stats; missing/null/invalid must not enter MODELING"
    },
    {
      "id": "intake_hygiene",
      "stage": "INTAKE",
      "order": 30,
      "kind": "hygiene",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_workspace_hygiene.py",
        "{root}",
        "--report",
        "{root}/workspace_hygiene_report.json"
      ],
      "reports": [
        "workspace_hygiene_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": null,
      "report_shape": "finding",
      "run_after": [],
      "description": "no temp scripts, duplicate result_bundle files, LaTeX aux, temp dirs"
    },
    {
      "id": "intake_manifest",
      "stage": "INTAKE",
      "order": 90,
      "kind": "manifest",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_pipeline_manifest.py",
        "--project-root",
        "{root}",
        "--stage",
        "intake",
        "--report",
        "--registry",
        "{repo}/.dsh/skills/paper-writer/references/artifact-registry.md"
      ],
      "reports": [
        "manifest_check_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": null,
      "report_shape": "error_count",
      "run_after": [
        "intake_convert",
        "intake_hygiene"
      ],
      "description": "artifact completeness gate for intake; must run after business checks"
    },
    {
      "id": "intake_machine_checks",
      "stage": "INTAKE",
      "order": 100,
      "kind": "audit",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_machine_checks.py",
        "{root}",
        "--stage",
        "intake"
      ],
      "reports": [],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": {
        "mode": "fallback"
      },
      "report_shape": "summary_error",
      "run_after": [
        "intake_manifest"
      ],
      "description": "fallback-mode evidence-chain audit; kernel mode records evidence directly"
    },
    {
      "id": "modeling_rework_plan",
      "stage": "MODELING",
      "order": 5,
      "kind": "kernel-gate",
      "command": [
        "kernel",
        "validate_rework_plan"
      ],
      "reports": [
        "decision_logs/rework_plan.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 30,
      "when": {
        "freshness": "fresh_dossier"
      },
      "report_shape": "exit_code",
      "run_after": [],
      "description": "before coding: every failure mode has a countermeasure and a runnable regression test; structural similarity to the rejected approach is justified"
    },
    {
      "id": "modeling_solution",
      "stage": "MODELING",
      "order": 10,
      "kind": "contract",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_solution_json.py",
        "{root}/result_bundle/solution.json",
        "{root}/project/results",
        "--report",
        "{root}/contract_check_report.json"
      ],
      "reports": [
        "contract_check_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 120,
      "when": {
        "track": "opt"
      },
      "report_shape": "finding",
      "run_after": [],
      "description": "opt solution.json contract and semantic checks"
    },
    {
      "id": "modeling_solution_stats",
      "stage": "MODELING",
      "order": 11,
      "kind": "contract",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_solution_json_stats.py",
        "{root}/result_bundle/solution.json",
        "{root}/project/results",
        "--report",
        "{root}/contract_check_report.json"
      ],
      "reports": [
        "contract_check_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 120,
      "when": {
        "track": "stats"
      },
      "report_shape": "finding",
      "run_after": [],
      "description": "stats solution.json contract and validation-design checks"
    },
    {
      "id": "modeling_artifacts",
      "stage": "MODELING",
      "order": 20,
      "kind": "contract",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_modeling_artifacts.py",
        "{root}",
        "--scope",
        "modeling",
        "--report",
        "{root}/modeling_artifacts_report.json"
      ],
      "reports": [
        "modeling_artifacts_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 120,
      "when": null,
      "report_shape": "finding",
      "run_after": [
        "modeling_solution"
      ],
      "description": "absolute paths, commercial solvers, fingerprint contract, no premature figures"
    },
    {
      "id": "modeling_code_hygiene",
      "stage": "MODELING",
      "order": 30,
      "kind": "hygiene",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_code_hygiene.py",
        "{root}/project",
        "--report",
        "{root}/code_hygiene_report.json"
      ],
      "reports": [
        "code_hygiene_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": null,
      "report_shape": "finding",
      "run_after": [],
      "description": "delivered code comments must not contain internal pipeline terms or emoji"
    },
    {
      "id": "modeling_hygiene",
      "stage": "MODELING",
      "order": 40,
      "kind": "hygiene",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_workspace_hygiene.py",
        "{root}",
        "--report",
        "{root}/workspace_hygiene_report.json"
      ],
      "reports": [
        "workspace_hygiene_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": null,
      "report_shape": "finding",
      "run_after": [],
      "description": "workspace hygiene at the modeling gate"
    },
    {
      "id": "modeling_leakage",
      "stage": "MODELING",
      "order": 50,
      "kind": "heuristic",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_leakage.py",
        "{root}/project",
        "--report",
        "{root}/leakage_check_report.json"
      ],
      "reports": [
        "leakage_check_report.json"
      ],
      "blocking": "WARN",
      "timeout_seconds": 60,
      "when": {
        "track": "stats"
      },
      "report_shape": "finding",
      "run_after": [
        "modeling_code_hygiene"
      ],
      "description": "stats track leakage heuristic; WARN only, reviewer adjudicates"
    },
    {
      "id": "modeling_manifest",
      "stage": "MODELING",
      "order": 90,
      "kind": "manifest",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_pipeline_manifest.py",
        "--project-root",
        "{root}",
        "--stage",
        "modeling",
        "--report",
        "--registry",
        "{repo}/.dsh/skills/paper-writer/references/artifact-registry.md"
      ],
      "reports": [
        "manifest_check_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": null,
      "report_shape": "error_count",
      "run_after": [
        "modeling_solution",
        "modeling_artifacts",
        "modeling_code_hygiene",
        "modeling_hygiene",
        "modeling_leakage"
      ],
      "description": "artifact completeness gate for modeling"
    },
    {
      "id": "modeling_machine_checks",
      "stage": "MODELING",
      "order": 100,
      "kind": "audit",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_machine_checks.py",
        "{root}",
        "--stage",
        "modeling"
      ],
      "reports": [],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": {
        "mode": "fallback"
      },
      "report_shape": "summary_error",
      "run_after": [
        "modeling_manifest"
      ],
      "description": "fallback-mode evidence-chain audit"
    },
    {
      "id": "method_hygiene",
      "stage": "METHOD",
      "order": 10,
      "kind": "hygiene",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_workspace_hygiene.py",
