      },
      "report_shape": "summary_error",
      "run_after": [
        "figures_manifest"
      ],
      "description": "fallback-mode evidence-chain audit"
    },
    {
      "id": "writing_latex_env",
      "stage": "WRITING",
      "order": 5,
      "kind": "preflight",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_latex_env.py",
        "--contest-profile={profile}",
        "--report",
        "{root}/latex_env_report.json"
      ],
      "reports": [
        "latex_env_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 120,
      "when": null,
      "on_error": "external_compile",
      "report_shape": "error_count",
      "run_after": [],
      "description": "LaTeX environment preflight; external compile mode on failure, never auto-install TeX"
    },
    {
      "id": "writing_compliance",
      "stage": "WRITING",
      "order": 10,
      "kind": "compliance",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_latex_compliance.py",
        "{root}/paper.tex",
        "{root}/project",
        "{root}/paper.pdf",
        "--contest-year={year}",
        "--contest-profile={profile}"
      ],
      "reports": [
        "latex_compliance_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 300,
      "when": null,
      "defer_on": "external_compile",
      "report_shape": "finding",
      "run_after": [
        "writing_latex_env"
      ],
      "description": "LaTeX compliance, structure, references, page count, abstract, anonymity; deferred until the user returns the external-compile PDF"
    },
    {
      "id": "writing_tex_numbers",
      "stage": "WRITING",
      "order": 20,
      "kind": "consistency",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_tex_numbers.py",
        "{root}/paper.tex",
        "{root}/result_bundle/solution.json",
        "--report",
        "{root}/tex_number_check_report.json"
      ],
      "reports": [
        "tex_number_check_report.json"
      ],
      "blocking": "WARN",
      "timeout_seconds": 120,
      "when": {
        "artifact": "paper_tex"
      },
      "report_shape": "finding",
      "run_after": [
        "writing_compliance"
      ],
      "description": "paper numbers vs solution.json; WARN only"
    },
    {
      "id": "writing_abstract",
      "stage": "WRITING",
      "order": 30,
      "kind": "consistency",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_abstract_guard.py",
        "audit",
        "{root}/paper.tex",
        "--contest-profile={profile}"
      ],
      "reports": [],
      "blocking": "WARN",
      "timeout_seconds": 60,
      "when": {
        "artifact": "paper_tex"
      },
      "report_shape": "finding",
      "run_after": [
        "writing_compliance"
      ],
      "description": "abstract length/structure/keyword warning; verify only after final abstract"
    },
    {
      "id": "writing_hygiene",
      "stage": "WRITING",
      "order": 40,
      "kind": "hygiene",
      "command": [
