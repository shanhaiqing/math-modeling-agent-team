        "{repo}/tools/checks/check_workspace_hygiene.py",
        "{root}",
        "--allow",
        "paper.aux,paper.log",
        "--report",
        "{root}/workspace_hygiene_report.json"
      ],
      "reports": [
        "workspace_hygiene_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": null,
      "report_shape": "finding",
      "run_after": [],
      "description": "workspace hygiene at the writing gate; paper.aux/log are page-count evidence"
    },
    {
