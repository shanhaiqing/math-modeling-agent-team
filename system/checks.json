        "--project-root",
        "{root}",
        "--stage",
        "method",
        "--report",
        "--registry",
        "{repo}/.dsh/skills/paper-writer/references/artifact-registry.md"
      ],
      "reports": [
        "manifest_check_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": null,
      "report_shape": "error_count",
      "run_after": [
        "method_hygiene"
      ],
      "description": "artifact completeness gate for method"
    },
    {
      "id": "method_machine_checks",
      "stage": "METHOD",
      "order": 100,
      "kind": "audit",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_machine_checks.py",
        "{root}",
        "--stage",
        "method"
      ],
      "reports": [],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": {
        "mode": "fallback"
      },
      "report_shape": "summary_error",
      "run_after": [
        "method_manifest"
      ],
      "description": "fallback-mode evidence-chain audit"
    },
    {
      "id": "figures_artifacts",
      "stage": "FIGURES",
      "order": 10,
      "kind": "contract",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_modeling_artifacts.py",
        "{root}",
        "--scope",
        "figures",
        "--report",
        "{root}/figures_artifacts_report.json"
      ],
      "reports": [
        "figures_artifacts_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 180,
      "when": null,
      "report_shape": "finding",
      "run_after": [],
      "description": "PDF+PNG pairing, >=6 figures, visual_qa, shuwei_en CJK ban"
    },
    {
      "id": "figures_hygiene",
      "stage": "FIGURES",
      "order": 20,
      "kind": "hygiene",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_workspace_hygiene.py",
        "{root}",
        "--report",
        "{root}/workspace_hygiene_report.json"
      ],
      "reports": [
        "workspace_hygiene_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": null,
      "report_shape": "finding",
      "run_after": [],
      "description": "workspace hygiene at the figures gate"
    },
    {
      "id": "figures_manifest",
      "stage": "FIGURES",
      "order": 90,
      "kind": "manifest",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_pipeline_manifest.py",
        "--project-root",
        "{root}",
        "--stage",
        "figures",
        "--report",
        "--registry",
        "{repo}/.dsh/skills/paper-writer/references/artifact-registry.md"
      ],
      "reports": [
        "manifest_check_report.json"
      ],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": null,
      "report_shape": "error_count",
      "run_after": [
