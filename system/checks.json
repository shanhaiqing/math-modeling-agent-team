    },
    {
      "id": "figures_machine_checks",
      "stage": "FIGURES",
      "order": 100,
      "kind": "audit",
      "command": [
        "{python}",
        "{repo}/tools/checks/check_machine_checks.py",
        "{root}",
        "--stage",
        "figures"
      ],
      "reports": [],
      "blocking": "ERROR",
      "timeout_seconds": 60,
      "when": {
